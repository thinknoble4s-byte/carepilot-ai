# Copy to .env (never commit .env). Read by infra/app.py and db/migrate.py.
AWS_REGION=ap-south-1

# 16+ random characters; the demo database is reachable from the internet.
CAREPILOT_DB_PASSWORD=

# Email for the AWS Budgets alert (80% actual, 100% forecast of US$30/month).
BUDGET_EMAIL=

# Server-side only (Lambda environment). Used from Increment 4.
SARVAM_API_KEY=

# true = also start the DB at 06:30 IST on weekdays. Default: start on demand.
CAREPILOT_DB_AUTOSTART=false
